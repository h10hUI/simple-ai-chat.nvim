{
  "tasks": {
    "run": "deno run --allow-net=api.anthropic.com --allow-env=ANTHROPIC_API_KEY main.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "test": "deno test --allow-env"
  },
  "imports": {},
  "lock": true,
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
